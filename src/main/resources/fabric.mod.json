{
	"schemaVersion": 1,
	"id": "minegpt",
	"version": "${version}",
	"name": "MineGPT",
	"description": "An autonomous Minecraft agent. This mod is MineGPT's body: it reads game state and carries out actions for the Python brain.",
	"authors": [
		"Rohan"
	],
	"license": "CC0-1.0",
	"icon": "assets/minegpt/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.xzier9.minegpt.MineGPT"
		],
		"client": [
			"com.xzier9.minegpt.client.MineGPTClient"
		]
	},
	"mixins": [
		"minegpt.mixins.json",
		{
			"config": "minegpt.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
